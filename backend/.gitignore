node_modules/
data/uploads/*
!data/uploads/.gitkeep
.env

# Toute variante de .env (ex: .env.atlas.backup) reste hors de Git,
# sauf les gabarits sans secret.
.env.*
!.env.example
!.env.local.example

# Lockfile généré par `bun install` dans les conteneurs Docker.
# La référence du projet reste package-lock.json.
bun.lock
